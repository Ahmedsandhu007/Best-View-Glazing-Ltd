# Copy to .env and fill in. Nothing here is committed.

# GitHub token that may read and start Actions and read/write Actions variables on the five store repositories.
# Leave empty on this PC to use the token of the signed-in `gh` CLI (gh auth token).
GITHUB_TOKEN=

# Path to a Google service-account key with read access to the five feed sheets (optional; sheet cards stay off without it).
GOOGLE_CREDENTIALS_FILE=

# Set a password once the dashboard is reachable from outside this PC. Empty = no login (local use only).
DASHBOARD_PASSWORD=

# Optional: any long random text. Keeps you signed in across restarts when the host forgets files (Cloud Run); not needed on a PC or a VPS.
DASHBOARD_SECRET=

# Where to listen. Keep 127.0.0.1 on this PC; on a server Caddy or nginx sits in front. Hosts that set PORT themselves need nothing here.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# Stores file (repo, sheet, tabs per store) and the local database folder.
STORES_FILE=config/stores.json
DATA_DIR=data
