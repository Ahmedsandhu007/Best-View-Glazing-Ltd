# Copy to .env.local and fill in ONE delivery backend for the enquiry form.
# Without a backend the form shows an honest "not connected" error – it never fakes success.

# Public URL of the deployed site (used for canonical URLs, Open Graph and sitemap)
NEXT_PUBLIC_SITE_URL=https://www.bestviewglazing.co.uk

# Option A – forward enquiries as JSON to any webhook (Make, Zapier, n8n, CRM, own server)
# ENQUIRY_WEBHOOK_URL=https://hook.example.com/your-endpoint
# ENQUIRY_WEBHOOK_SECRET=change-me            # optional, sent as X-Enquiry-Secret

# Option B – email enquiries through Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxx
# ENQUIRY_TO_EMAIL=enquiries@yourdomain.co.uk  # comma-separate for several inboxes
# ENQUIRY_FROM_EMAIL="Best View Glazing Website <enquiries@yourdomain.co.uk>"   # must be a verified sender
